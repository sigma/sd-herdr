{
  "name": "sd-herdr",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Stream Deck attention button for a herdr session",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
